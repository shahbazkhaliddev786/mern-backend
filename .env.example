# General environment variables for development
ENV=development
PORT=4000
SERVER_URL=http:localhost:4000

# Database configuration
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.tdwwfvx.mongodb.net/aljo-store
DATABASE_NAME=aljo-store


# Cloudinary Keys
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_CLOUD_NAME=dgx9candm

# Auth
SESSION_SECRET=your_session_secret
JWT_SECRET=your_jwt_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=10d

# Email
GMAIL=shahbazkhalid818@gmail.com
PASSWORD=your_smtp_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# Stripe
STRIPE_SECRET=your_stripe_secret_key
FRONTEND_URL=http://localhost:5173
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Support requests (/contact form + the agent's submit_support_request) — Make.com webhook that feeds the support inbox
SUPPORT_WEBHOOK_URL=your_make_com_webhook_url

# AI shopping agent (docs/shopping-agent, spec 003)
# Off by default; while false the chat endpoint answers 503 and nothing below is required.
AGENT_ENABLED=false
# Required when AGENT_ENABLED=true
ANTHROPIC_API_KEY=your_anthropic_api_key
# Store-knowledge embeddings and rerank (required when AGENT_ENABLED=true, spec 013)
VOYAGE_API_KEY=your_voyage_api_key

# LangSmith tracing (LangChain reads these directly)
LANGSMITH_TRACING=false
# Required when LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=aljo-store-agent

# Optional (spec 016): urgent agent alerts (card data near the model, a write without confirmation)
# are also POSTed here as { "text": ... }. A Slack incoming webhook or a Make.com scenario works.
ALERT_WEBHOOK_URL=

# TEMPORARY (spec 004): streaming probe at POST /api/v1/agent/_stream-probe. Keep false except on a probe preview.
STREAM_PROBE_ENABLED=false
